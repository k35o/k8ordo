{
  "name": "docs",
  "version": "0.0.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:docs && vp dev",
    "build": "pnpm generate:docs && vp build",
    "generate:docs": "node scripts/copy-reference-docs.ts",
    "typecheck": "better-css-modules generate && tsc -b",
    "check": "better-css-modules generate && vp check && better-css-modules check",
    "check:write": "better-css-modules generate && vp check --fix"
  },
  "dependencies": {
    "@fontsource-variable/m-plus-2": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@k8ordo/color-scheme": "workspace:^",
    "@k8ordo/form": "workspace:^",
    "@k8ordo/i18n": "workspace:^",
    "@k8ordo/router": "workspace:^",
    "@k8ordo/state": "workspace:^",
    "@k8ordo/ui": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-css-modules/cli": "catalog:",
    "@better-css-modules/core": "catalog:",
    "@better-css-modules/vite": "catalog:",
    "@k8ordo/framework": "workspace:^",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  }
}
