{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>k35o/renovate-config",
    "monorepo:storybook",
    "monorepo:react",
    "monorepo:vitest"
  ],
  "mise": {
    "enabled": true,
    "managerFilePatterns": ["/^mise\\.toml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "イメージのタグを npm の playwright と同じ PR で上げる。docker として数えると、MCR には公開日時が無く minimumReleaseAge に止められる",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "mcr\\.microsoft\\.com/playwright:v(?<currentValue>\\d+\\.\\d+\\.\\d+)-"
      ],
      "depNameTemplate": "playwright",
      "datasourceTemplate": "npm"
    }
  ],
  "prConcurrentLimit": 10,
  "ignorePaths": ["**/node_modules/**"],
  "packageRules": [
    {
      "matchPackageNames": ["/^@storybook/", "/^storybook$/"],
      "groupName": "storybook dependencies"
    },
    {
      "matchPackageNames": ["/^vitest$/", "/@vitest/"],
      "groupName": "vitest dependencies"
    },
    {
      "description": "@k8o/oxc-config は vite-plus が同梱する oxlint に合わせて規則を決め、minor でも規則を厳しくする。一部だけ上げても Lint が通らないので、major も含めて 1 本の PR にまとめ、コードを直してから手でマージする",
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "vite-plus-inspector",
        "@k8o/oxc-config",
        "oxlint-tailwindcss"
      ],
      "groupName": "vite-plus toolchain",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchPackageNames": ["/^react$/", "/^react-dom$/"],
      "groupName": "react dependencies"
    },
    {
      "matchPackageNames": ["/^pnpm$/"],
      "groupName": "pnpm dependencies"
    },
    {
      "matchPackageNames": ["/^node$/"],
      "groupName": "node dependencies"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "0.x の minor は peer の範囲を越える。catalog だけが上がって自動マージされないよう、peer・docs・changeset を手で直す PR に分ける",
      "matchPackageNames": ["/^@json-render/", "/^@openuidev/"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "generative-UI peer dependencies",
      "automerge": false
    },
    {
      "description": "oxc-transform-react の 0.x の minor は @vitejs/plugin-react の peer の範囲を越える。plugin-react は patch でもその peer を動かす (6.1.2 で ^0.145.0 から ^0.152.0)。片方だけが上がって自動マージされないよう、patch も含めて 1 本の PR にまとめ、@k8ordo/framework の peer と changeset を手で直す",
      "matchPackageNames": ["oxc-transform-react", "@vitejs/plugin-react"],
      "groupName": "React Compiler peer dependencies",
      "automerge": false
    },
    {
      "description": "customManagers が上げるので、docker としては拾わない",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["mcr.microsoft.com/playwright"],
      "enabled": false
    },
    {
      "description": "Playwright 1.64 の Firefox (r1553〜r1560) は子フレームの文書にもフォーカスのエミュレーションを広げ、iframe から親へフォーカスが移らない (microsoft/playwright#43280)。フォーカスを持った iframe を外すと、次の iframe での最初の focus() も届かない。vitest はテストファイルごとに iframe を作り直すので ui の Firefox のテストが落ちる。r1562 で元に戻されたので、1.64 だけを飛ばして次の minor を待つ",
      "matchPackageNames": ["playwright"],
      "allowedVersions": "!/^1\\.64\\./"
    }
  ]
}
