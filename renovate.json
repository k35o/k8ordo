{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>k35o/renovate-config",
    "monorepo:storybook",
    "monorepo:react",
    "monorepo:vitest"
  ],
  "mise": {
    "enabled": true,
    "managerFilePatterns": ["/^mise\\.toml$/"]
  },
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchPackageNames": ["/^@storybook/", "/^storybook$/"],
      "groupName": "storybook dependencies"
    },
    {
      "matchPackageNames": ["/^vitest$/", "/@vitest/"],
      "groupName": "vitest dependencies"
    },
    {
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "vite-plus dependencies"
    },
    {
      "matchPackageNames": ["/^react$/", "/^react-dom$/"],
      "groupName": "react dependencies"
    },
    {
      "matchPackageNames": ["/^pnpm$/"],
      "groupName": "pnpm dependencies"
    },
    {
      "matchPackageNames": ["/^node$/"],
      "groupName": "node dependencies"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "0.x の minor は peer の範囲を越える。catalog だけが上がって自動マージされないよう、peer・docs・changeset を手で直す PR に分ける",
      "matchPackageNames": ["/^@json-render/", "/^@openuidev/"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "generative-UI peer dependencies",
      "automerge": false
    }
  ]
}
