{
  "name": "k8ordo",
  "private": true,
  "description": "k8o's React library family",
  "license": "MIT",
  "author": "k8o",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/k8ordo.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run --filter './packages/*' --filter './apps/*' build",
    "build:examples": "vp run --filter './examples/*' build",
    "test": "vp run -r test",
    "test:examples": "vp run --filter './examples/*' test",
    "test:ui": "vp run -r test:ui",
    "test:coverage": "vp run -r test:coverage",
    "typecheck": "vp run -r typecheck",
    "check": "vp run -r check",
    "check:write": "vp run -r check:write",
    "check:no-polyfills": "node scripts/check-no-polyfills.mjs",
    "inspect": "vp-inspect"
  },
  "devDependencies": {
    "@k8o/oxc-config": "0.3.0",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "24.13.3",
    "oxlint-tailwindcss": "1.10.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vite-plus-inspector": "0.1.1",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@11.21.0"
}
