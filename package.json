{
  "name": "k8ordo",
  "private": true,
  "description": "k8o's React library family",
  "license": "MIT",
  "author": "k8o",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/k8ordo.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run --filter './packages/*' --filter './apps/*' build",
    "build:examples": "vp run --filter './examples/*' build",
    "test": "vp run -r test",
    "test:examples": "vp run --filter './examples/*' test",
    "test:ui": "vp run -r test:ui",
    "test:coverage": "vp run -r test:coverage",
    "typecheck": "vp run -r typecheck",
    "check": "vp run -r check && node scripts/sync-peer-tables.ts --check",
    "check:write": "vp run -r check:write && node scripts/sync-peer-tables.ts",
    "check:no-polyfills": "node scripts/check-no-polyfills.mjs",
    "check:peer-copies": "node scripts/check-peer-copies.mjs",
    "inspect": "vp-inspect"
  },
  "devDependencies": {
    "@k8o/oxc-config": "0.3.0",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "oxlint-tailwindcss": "1.13.0",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vite-plus-inspector": "1.0.0",
    "wrangler": "4.136.3"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@12.8.2"
}
