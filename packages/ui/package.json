{
  "name": "@k8ordo/ui",
  "version": "4.0.0",
  "description": "k8o's React UI library, with a format-neutral catalog of its components for LLM-driven, on-brand generative UI",
  "keywords": [
    "ai",
    "components",
    "design-system",
    "generative-ui",
    "k8o",
    "llm",
    "react",
    "typescript",
    "ui"
  ],
  "homepage": "https://ordo.k8o.me",
  "bugs": {
    "url": "https://github.com/k35o/k8ordo/issues"
  },
  "license": "MIT",
  "author": "k8o <kosakanoki@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/k8ordo.git"
  },
  "files": [
    "dist/**",
    "docs/**"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./tokens": {
      "types": "./dist/styles/tokens.d.mts",
      "default": "./dist/styles/tokens.mjs"
    },
    "./props.json": "./docs/props.generated.json",
    "./catalog": {
      "types": "./dist/catalog/index.d.mts",
      "default": "./dist/catalog/index.mjs"
    },
    "./catalog/render": {
      "types": "./dist/catalog/render.d.mts",
      "default": "./dist/catalog/render.mjs"
    },
    "./ai": {
      "types": "./dist/components/ai/index.d.mts",
      "default": "./dist/components/ai/index.mjs"
    },
    "./ai/response": {
      "types": "./dist/components/ai/response/index.d.mts",
      "default": "./dist/components/ai/response/index.mjs"
    },
    "./icons": {
      "types": "./dist/components/icons/index.d.mts",
      "default": "./dist/components/icons/index.mjs"
    },
    "./code-block": {
      "types": "./dist/components/data-display/code-block/index.d.mts",
      "default": "./dist/components/data-display/code-block/index.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.mts",
      "default": "./dist/i18n/index.mjs"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack && node scripts/build-tokens.ts",
    "generate:props": "node scripts/generate-icons.ts && node scripts/extract-props.ts && node scripts/generate-component-docs.ts",
    "check:props": "node scripts/generate-icons.ts --check && node scripts/extract-props.ts --check && node scripts/generate-component-docs.ts --check",
    "check:dist": "node scripts/check-dist-tests.ts",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./tokens.css ./tailwind.css && pnpm check:dist",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:vrt": "VRT=1 TEST_BROWSER=chromium vitest run --project=components",
    "test": "vitest run",
    "test:ui": "TEST_BROWSER=chromium vitest --ui --coverage",
    "test:coverage": "TEST_BROWSER=chromium vitest run --coverage",
    "typecheck": "better-css-modules generate && tsc --noEmit",
    "check": "better-css-modules generate && vp check && better-css-modules check",
    "check:write": "better-css-modules generate && vp check --fix"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@better-css-modules/cli": "catalog:",
    "@better-css-modules/core": "catalog:",
    "@better-css-modules/vite": "catalog:",
    "@chromatic-com/storybook": "5.6.0",
    "@k8ordo/form": "workspace:^",
    "@k8ordo/i18n": "workspace:^",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-mcp": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "postcss": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "4.6.0",
    "storybook": "10.6.8",
    "storybook-addon-determinism": "0.2.1",
    "storybook-addon-mock-date": "3.2.1",
    "storybook-addon-vrt": "0.4.2",
    "streamdown": "2.8.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@k8ordo/i18n": "workspace:^",
    "@types/react": ">=19.3.0",
    "@types/react-dom": ">=19.3.0",
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0",
    "shiki": ">=4.6.0",
    "streamdown": ">=2.5.0",
    "typescript": ">=7.0.0",
    "zod": "^4.6.6"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "streamdown": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
