{
  "name": "@k8ordo/ui",
  "version": "2.1.0",
  "description": "k8o's React UI library with built-in generative UI adapters (json-render & OpenUI) for LLM-driven, on-brand interfaces",
  "keywords": [
    "ai",
    "components",
    "design-system",
    "generative-ui",
    "json-render",
    "k8o",
    "llm",
    "openui",
    "react",
    "typescript",
    "ui"
  ],
  "homepage": "https://ordo.k8o.me",
  "bugs": {
    "url": "https://github.com/k35o/k8ordo/issues"
  },
  "license": "MIT",
  "author": "k8o <kosakanoki@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/k8ordo.git"
  },
  "files": [
    "dist/**",
    "docs/**"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./tokens": {
      "types": "./dist/styles/tokens.d.mts",
      "default": "./dist/styles/tokens.mjs"
    },
    "./props.json": "./docs/props.generated.json",
    "./json-render": {
      "types": "./dist/integrations/json-render/catalog.d.mts",
      "default": "./dist/integrations/json-render/catalog.mjs"
    },
    "./json-render/registry": {
      "types": "./dist/integrations/json-render/registry.d.mts",
      "default": "./dist/integrations/json-render/registry.mjs"
    },
    "./openui": {
      "types": "./dist/integrations/openui/library.d.mts",
      "default": "./dist/integrations/openui/library.mjs"
    },
    "./openui/prompt": {
      "types": "./dist/integrations/openui/prompt.d.mts",
      "default": "./dist/integrations/openui/prompt.mjs"
    },
    "./ai": {
      "types": "./dist/components/ai/index.d.mts",
      "default": "./dist/components/ai/index.mjs"
    },
    "./ai/response": {
      "types": "./dist/components/ai/response/index.d.mts",
      "default": "./dist/components/ai/response/index.mjs"
    },
    "./code-block": {
      "types": "./dist/components/data-display/code-block/index.d.mts",
      "default": "./dist/components/data-display/code-block/index.mjs"
    },
    "./ai-sdk": {
      "types": "./dist/integrations/ai-sdk/index.d.mts",
      "default": "./dist/integrations/ai-sdk/index.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.mts",
      "default": "./dist/i18n/index.mjs"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tailwind.css": "./dist/styles/tailwind.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack && node scripts/build-tokens.ts",
    "generate:props": "node scripts/extract-props.ts && node scripts/generate-component-docs.ts",
    "check:props": "node scripts/extract-props.ts --check && node scripts/generate-component-docs.ts --check",
    "check:dist": "node scripts/check-dist-tests.ts",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./tailwind.css && pnpm check:dist",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:vrt": "VRT=1 TEST_BROWSER=chromium vitest run --project=components",
    "test": "vitest run",
    "test:ui": "TEST_BROWSER=chromium vitest --ui --coverage",
    "test:coverage": "TEST_BROWSER=chromium vitest run --coverage",
    "typecheck": "better-css-modules generate && tsc --noEmit",
    "check": "better-css-modules generate && vp check && better-css-modules check",
    "check:write": "better-css-modules generate && vp check --fix"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "server-only": "catalog:",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@better-css-modules/cli": "catalog:",
    "@better-css-modules/core": "catalog:",
    "@better-css-modules/vite": "catalog:",
    "@chromatic-com/storybook": "5.5.1",
    "@json-render/core": "catalog:",
    "@json-render/react": "catalog:",
    "@k8ordo/form": "workspace:^",
    "@k8ordo/i18n": "workspace:^",
    "@openuidev/lang-core": "catalog:",
    "@openuidev/react-lang": "catalog:",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-mcp": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "ai": "catalog:",
    "postcss": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.2",
    "storybook-addon-determinism": "0.2.1",
    "storybook-addon-mock-date": "3.2.1",
    "storybook-addon-vrt": "0.4.0",
    "streamdown": "2.7.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@json-render/core": ">=0.21.0 <0.22.0",
    "@json-render/react": ">=0.21.0 <0.22.0",
    "@k8ordo/i18n": "workspace:^",
    "@openuidev/lang-core": "^1.0.0",
    "@openuidev/react-lang": "^1.0.0",
    "@types/react": ">=19.3.0",
    "@types/react-dom": ">=19.3.0",
    "ai": ">=7.0.51",
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0",
    "streamdown": ">=2.5.0",
    "typescript": ">=7.0.0",
    "zod": "^4.6.6"
  },
  "peerDependenciesMeta": {
    "@json-render/core": {
      "optional": true
    },
    "@json-render/react": {
      "optional": true
    },
    "@openuidev/lang-core": {
      "optional": true
    },
    "@openuidev/react-lang": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "streamdown": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
