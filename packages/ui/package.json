{
  "name": "@k8ordo/ui",
  "version": "1.0.0",
  "description": "k8o's React UI library with built-in generative UI adapters (json-render & OpenUI) for LLM-driven, on-brand interfaces",
  "keywords": [
    "ai",
    "components",
    "design-system",
    "generative-ui",
    "json-render",
    "k8o",
    "llm",
    "openui",
    "react",
    "typescript",
    "ui"
  ],
  "homepage": "https://ordo.k8o.me",
  "bugs": {
    "url": "https://github.com/k35o/k8ordo/issues"
  },
  "license": "MIT",
  "author": "k8o <kosakanoki@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/k8ordo.git"
  },
  "files": [
    "dist/**",
    "docs/**"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./tokens": {
      "types": "./dist/styles/tokens.d.mts",
      "default": "./dist/styles/tokens.mjs"
    },
    "./props.json": "./docs/props.generated.json",
    "./json-render": {
      "types": "./dist/integrations/json-render/catalog.d.mts",
      "default": "./dist/integrations/json-render/catalog.mjs"
    },
    "./json-render/registry": {
      "types": "./dist/integrations/json-render/registry.d.mts",
      "default": "./dist/integrations/json-render/registry.mjs"
    },
    "./openui": {
      "types": "./dist/integrations/openui/library.d.mts",
      "default": "./dist/integrations/openui/library.mjs"
    },
    "./openui/prompt": {
      "types": "./dist/integrations/openui/prompt.d.mts",
      "default": "./dist/integrations/openui/prompt.mjs"
    },
    "./ai": {
      "types": "./dist/components/ai/index.d.mts",
      "default": "./dist/components/ai/index.mjs"
    },
    "./ai/response": {
      "types": "./dist/components/ai/response/index.d.mts",
      "default": "./dist/components/ai/response/index.mjs"
    },
    "./ai-sdk": {
      "types": "./dist/integrations/ai-sdk/index.d.mts",
      "default": "./dist/integrations/ai-sdk/index.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.mts",
      "default": "./dist/i18n/index.mjs"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tailwind.css": "./dist/styles/tailwind.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack && pnpm build:css",
    "build:css": "node scripts/build-css.ts",
    "generate:tokens": "tailwind-token-extractor src/styles/index.css -o src/styles/tokens.generated.ts",
    "check:tokens": "tailwind-token-extractor check src/styles/index.css -o src/styles/tokens.generated.ts",
    "generate:props": "node scripts/extract-props.ts && node scripts/generate-components-md.ts",
    "check:props": "node scripts/extract-props.ts --check && node scripts/generate-components-md.ts --check",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./tailwind.css",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:vrt": "VRT=1 vitest run --project=components",
    "test": "vitest run",
    "test:ui": "vitest --ui --coverage",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "check:write": "vp check --fix"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@chromatic-com/storybook": "5.3.0",
    "@json-render/core": "0.19.0",
    "@json-render/react": "0.19.0",
    "@openuidev/lang-core": "0.2.12",
    "@openuidev/react-lang": "0.2.11",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "ai": "7.0.65",
    "postcss": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.5.10",
    "storybook-addon-determinism": "0.1.2",
    "storybook-addon-mock-date": "3.1.1",
    "storybook-addon-vrt": "0.4.0",
    "streamdown": "2.5.0",
    "tailwind-token-extractor": "0.2.1",
    "tailwindcss": "catalog:",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.2.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@json-render/core": ">=0.19.0",
    "@json-render/react": ">=0.19.0",
    "@openuidev/lang-core": ">=0.2.10",
    "@openuidev/react-lang": ">=0.2.9",
    "@types/react": ">=19.2.18",
    "@types/react-dom": ">=19.2.4",
    "ai": ">=7.0.51",
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6",
    "streamdown": ">=2.5.0",
    "tailwindcss": ">=4.3.3",
    "typescript": ">=7.0.2",
    "zod": ">=4.4.3"
  },
  "peerDependenciesMeta": {
    "@json-render/core": {
      "optional": true
    },
    "@json-render/react": {
      "optional": true
    },
    "@openuidev/lang-core": {
      "optional": true
    },
    "@openuidev/react-lang": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "streamdown": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
