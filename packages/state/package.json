{
  "name": "@k8ordo/state",
  "version": "0.2.0",
  "description": "Declare state by where it lives — URL search params, history-entry state, localStorage, sessionStorage, a cookie, or memory. One zod schema per boundary place and a typed box for memory, over the Navigation API.",
  "keywords": [
    "cookie",
    "localstorage",
    "navigation-api",
    "react",
    "search-params",
    "server-components",
    "sessionstorage",
    "state",
    "url-state",
    "zod"
  ],
  "homepage": "https://ordo.k8o.me",
  "bugs": {
    "url": "https://github.com/k35o/k8ordo/issues"
  },
  "license": "MIT",
  "author": "k8o <kosakanoki@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/k8ordo.git"
  },
  "files": [
    "dist/**",
    "docs/**"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "check:write": "vp check --fix",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@k8ordo/router": "workspace:^",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@k8ordo/router": "workspace:^",
    "@types/react": ">=19.3.0",
    "react": ">=19.3.0",
    "typescript": ">=7.0.2",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@k8ordo/router": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
