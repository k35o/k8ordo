{
  "name": "@k8ordo/state",
  "version": "0.1.0",
  "description": "Declare state by where it lives — URL search params, history-entry state, localStorage, or memory. One zod schema per place, over the Navigation API.",
  "keywords": [
    "localstorage",
    "navigation-api",
    "react",
    "search-params",
    "server-components",
    "state",
    "url-state",
    "zod"
  ],
  "homepage": "https://ordo.k8o.me",
  "bugs": {
    "url": "https://github.com/k35o/k8ordo/issues"
  },
  "license": "MIT",
  "author": "k8o <kosakanoki@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/k8ordo.git"
  },
  "files": [
    "dist/**",
    "docs/**"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "check:write": "vp check --fix"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "4.1.10",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.2.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@types/react": ">=19.2.18",
    "react": ">=19.2.6",
    "typescript": ">=7.0.2",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
