{
  "name": "@k8ordo/form",
  "version": "0.1.0",
  "description": "Derive HTML constraint attributes and per-field errors from one zod schema. Works without JavaScript.",
  "keywords": [
    "constraint-validation",
    "form",
    "progressive-enhancement",
    "react",
    "server-actions",
    "zod"
  ],
  "homepage": "https://ordo.k8o.me",
  "license": "MIT",
  "author": "k8o <kosakanoki@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/k8ordo.git"
  },
  "files": [
    "dist/**",
    "docs/**"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "check:write": "vp check --fix",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "4.1.11",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.2.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@types/react": ">=19.2.18",
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6",
    "typescript": ">=7.0.2",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
