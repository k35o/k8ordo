{
  "name": "@k8ordo/framework-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Internal engine bundled into @k8ordo/static and @k8ordo/server. Not published.",
  "license": "MIT",
  "author": "k8o <kosakanoki@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/k8ordo.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "check": "vp check && node scripts/sync-guides.ts --check",
    "check:write": "vp check --fix && node scripts/sync-guides.ts",
    "sync:guides": "node scripts/sync-guides.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "0.5.35",
    "rsc-html-stream": "0.0.8"
  },
  "devDependencies": {
    "@k8ordo/router": "workspace:^",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@k8ordo/router": "workspace:^",
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0",
    "vite": ">=8.2.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
